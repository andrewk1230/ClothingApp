# Database
DATABASE_URL=postgresql+asyncpg://grailseeker:grailseeker@localhost:5432/grailseeker

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ML Models
CLIP_MODEL=ViT-B-32-quickgelu
CLIP_PRETRAINED=openai
YOLO_WEIGHTS_PATH=app/ml/weights/deepfashion2_yolov8s-seg.pt

# eBay Browse API (register at https://developer.ebay.com)
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_API_URL=https://api.ebay.com
EBAY_AUTH_URL=https://api.ebay.com

# Ingestion
INGEST_INTERVAL_MINUTES=30
CLEANUP_HOUR=3

# Rate Limits
GUEST_DAILY_LIMIT=5
USER_DAILY_LIMIT=50

# Image Processing
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_DIMENSION=1024
