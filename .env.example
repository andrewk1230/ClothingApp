# Database
DATABASE_URL=postgresql+asyncpg://grailseeker:grailseeker@localhost:5432/grailseeker

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ML Models
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
YOLO_WEIGHTS_PATH=app/ml/weights/yolov8_fashion.pt

# Scraper
SCRAPE_INTERVAL_MINUTES=30
SCRAPE_DELAY_SECONDS=2
CLEANUP_HOUR=3

# Rate Limits
GUEST_DAILY_LIMIT=5
USER_DAILY_LIMIT=50

# Image Processing
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_DIMENSION=1024
