# Environment: "production" disables /docs + /openapi.json and stops trusting
# X-Forwarded-For for guest rate limiting (CF-Connecting-IP only). Set to
# production on the serving PC.
ENVIRONMENT=development

# Database — on the serving PC set a strong POSTGRES_PASSWORD (used by
# docker-compose) and mirror it here before the first `docker compose up`.
POSTGRES_PASSWORD=grailseeker
DATABASE_URL=postgresql+asyncpg://grailseeker:grailseeker@localhost:5432/grailseeker

# Supabase Auth — with SUPABASE_JWT_SECRET left empty, tokens are verified
# against the project's JWKS endpoint (RS256/ES256; recommended). Only set
# SUPABASE_JWT_SECRET on legacy projects still using the shared HS256 secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=
# Server-only (Supabase dashboard -> API keys). Required for in-app account
# deletion (DELETE /api/v1/account). Never expose to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API — loopback only; the Cloudflare tunnel connects via localhost
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ML Models
CLIP_MODEL=ViT-B-32-quickgelu
CLIP_PRETRAINED=openai
YOLO_WEIGHTS_PATH=app/ml/weights/deepfashion2_yolov8s-seg.pt

# eBay Browse API (register at https://developer.ebay.com)
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_API_URL=https://api.ebay.com
EBAY_AUTH_URL=https://api.ebay.com

# Ingestion
INGEST_INTERVAL_MINUTES=30
CLEANUP_HOUR=3

# Rate Limits
GUEST_DAILY_LIMIT=5
USER_DAILY_LIMIT=50
# Abuse cap on /find (unmetered per PRD §4.5); generous, per caller per day
FIND_DAILY_LIMIT=200
# Days of rate-limit rows kept by the nightly cleanup
RATE_LIMIT_RETENTION_DAYS=7

# Listing stale-check: serve stored status for this long before re-hitting eBay
LISTING_CHECK_TTL_MINUTES=15

# Image Processing
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_DIMENSION=1024
# Decompression-bomb guard: reject images with more pixels before full decode
MAX_IMAGE_PIXELS=40000000
